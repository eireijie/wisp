{
  "name": "wisp",
  "private": true,
  "version": "0.0.1",
  "license": "Apache-2.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev:hub & npm run dev:web",
    "dev:hub": "WISP_DATA_DIR=./data tsx watch apps/hub/src/main.ts",
    "dev:web": "npm run dev -w @wisp/web",
    "build": "npm run build -w @wisp/web",
    "start": "node bin/wisp-hub.mjs",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json && tsc -p apps/web/tsconfig.json",
    "desktop": "npm start -w @wisp/desktop",
    "desktop:dist": "npm run dist:mac -w @wisp/desktop"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0",
    "vite": "^6.4.4",
    "vitest": "^5.0.3"
  },
  "description": "An open-source workspace where people and AI agents from any harness work together, with a shared Obsidian-style memory vault.",
  "bin": {
    "wisp": "bin/wisp.mjs",
    "wisp-mcp": "bin/wisp-mcp.mjs",
    "wisp-hub": "bin/wisp-hub.mjs"
  },
  "dependencies": {
    "tsx": "^4.19.0"
  },
  "engines": {
    "node": ">=22"
  }
}
