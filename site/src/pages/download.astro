---
import Base from "../layouts/Base.astro";
import Ghost from "../components/Ghost.astro";
import Cmd from "../components/Cmd.astro";
import { DOWNLOADS, RELEASES, INSTALL_UNIX, INSTALL_WINDOWS, INSTALL_DOCKER } from "../lib/site";
---

<Base
  title="Download"
  description="Download Wisp for Mac, Windows, Linux and Android. The iPhone app is coming soon."
  current="download"
>
  <div class="wrap">
    <header class="page-head">
      <h1>Download Wisp</h1>
      <p>
        Free for everyone. The app runs Wisp on your computer, or connects to a Wisp someone already runs, like a
        server at home or at work.
      </p>
    </header>

    <section aria-labelledby="computers-title">
      <h2 id="computers-title" class="group-title">For your computer</h2>
      <ul class="cards">
        <li class="card sheet" data-os="mac">
          <h3>Mac</h3>
          <p class="meta">macOS on Apple silicon (M1 and newer) or Intel</p>
          <div class="pair">
            <a class="btn btn-primary" href={DOWNLOADS.mac}>Apple silicon <small>.dmg</small></a>
            <a class="btn btn-quiet" href={DOWNLOADS.macIntel}>Intel <small>.dmg</small></a>
          </div>
          <p class="hint">
            Open the file and drag Wisp to Applications. This early version isn't signed by Apple yet, so the first
            time macOS refuses it: go to System Settings, Privacy &amp; Security, and choose <strong>Open Anyway</strong>.
          </p>
        </li>
        <li class="card sheet" data-os="windows">
          <h3>Windows</h3>
          <p class="meta">Windows 10 and 11, 64-bit</p>
          <a class="btn btn-primary" href={DOWNLOADS.windows}>Download for Windows <small>.exe</small></a>
          <p class="hint">
            Run the installer. If Windows says it protected your PC, choose <strong>More info</strong>, then{" "}
            <strong>Run anyway</strong>.
          </p>
        </li>
        <li class="card sheet" data-os="linux">
          <h3>Linux</h3>
          <p class="meta">64-bit (x86_64)</p>
          <div class="pair">
            <a class="btn btn-primary" href={DOWNLOADS.linuxAppImage}>AppImage</a>
            <a class="btn btn-quiet" href={DOWNLOADS.linuxDeb}>Debian / Ubuntu <small>.deb</small></a>
          </div>
          <p class="hint">
            The AppImage runs on most Linux systems: make it executable and open it. The .deb installs on Debian, Ubuntu and
            similar.
          </p>
        </li>
      </ul>
      <p class="all">
        Looking for an older version or another file? See <a href={RELEASES} rel="noopener">all releases on GitHub</a>.
      </p>
    </section>

    <section aria-labelledby="phones-title" class="phones">
      <h2 id="phones-title" class="group-title">For your phone</h2>
      <ul class="cards two">
        <li class="card sheet">
          <h3>iPhone and iPad</h3>
          <p class="meta">App Store</p>
          <span class="soon">Coming soon</span>
          <p class="hint">Chats, your agents, requests that need your OK, and watching or taking over agents' computers.</p>
        </li>
        <li class="card sheet">
          <h3>Android</h3>
          <p class="meta">Android 8 and newer · Google Play coming soon</p>
          <a class="btn btn-quiet" href={DOWNLOADS.android}>Download the preview <small>.apk</small></a>
          <p class="hint">
            Open the file on your phone and allow installing from your browser when Android asks. Chats, your agents,
            requests that need your OK, and watching or taking over agents' computers.
          </p>
        </li>
      </ul>
      <div class="pairing sheet">
        <Ghost size={52} color="#ffe1ec" color2="#ff7aa8" mood="happy" class="float" />
        <div>
          <h3>How the phone app connects</h3>
          <p>
            The phone app doesn't have an account of its own. It pairs with Wisp on your computer. Open Wisp on your
            computer, go to <strong>Settings → Mobile</strong>, and scan the QR code with the phone app. That's it.
          </p>
          <p>
            Your phone needs to be able to reach that computer: on the same Wi-Fi, or from anywhere with a private network
            like Tailscale. See <a href="/docs/deploy/#reaching-it-from-your-phone">reaching Wisp from your phone</a>.
          </p>
        </div>
      </div>
    </section>

    <section aria-labelledby="server-title" class="server">
      <h2 id="server-title" class="group-title">Prefer the command line?</h2>
      <p class="intro">
        You can also install Wisp with one command, for example on a server that's always on. It needs git and Node 22
        or newer (it offers to install Node for you), and asks before it installs anything.
      </p>
      <div class="cmds">
        <div>
          <h3>macOS or Linux</h3>
          <Cmd code={INSTALL_UNIX} label="Install command for macOS or Linux" />
        </div>
        <div>
          <h3>Windows (PowerShell)</h3>
          <Cmd code={INSTALL_WINDOWS} label="Install command for Windows PowerShell" />
        </div>
        <div>
          <h3>Docker</h3>
          <Cmd code={INSTALL_DOCKER} label="Docker command" />
        </div>
      </div>
      <p class="intro">
        Then open <code>http://localhost:4747</code> and create your workspace. The full guide is in{" "}
        <a href="/docs/install/">Installing Wisp</a>.
      </p>
    </section>
  </div>
</Base>

<style>
  .group-title {
    font-size: 1.4rem;
    margin: 12px 0 16px;
  }
  .cards {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 18px;
  }
  .cards.two {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
  .card {
    padding: 24px;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 10px;
  }
  .card h3 {
    font-size: 1.35rem;
    margin: 0;
  }
  .meta {
    color: var(--muted);
    margin: 0;
    font-size: 0.95rem;
  }
  .hint {
    color: var(--muted);
    font-size: 0.93rem;
    margin: 4px 0 0;
  }
  .pair {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .soon {
    display: inline-block;
    font-weight: 700;
    font-size: 0.9rem;
    color: var(--accent-text);
    background: var(--accent-soft);
    padding: 8px 14px;
    border-radius: 16px;
  }
  .all {
    margin-top: 18px;
    color: var(--muted);
  }
  .phones,
  .server {
    margin-top: 56px;
  }
  .pairing {
    margin-top: 18px;
    padding: 24px;
    display: grid;
    grid-template-columns: 52px minmax(0, 1fr);
    gap: 20px;
    align-items: start;
  }
  .pairing h3 {
    font-size: 1.2rem;
  }
  .pairing p {
    color: var(--muted);
  }
  .pairing p:last-child {
    margin: 0;
  }
  .pairing strong {
    color: var(--ink);
  }
  .intro {
    color: var(--muted);
    max-width: 720px;
  }
  .cmds h3 {
    font-family: var(--font-sans);
    font-size: 0.95rem;
    font-weight: 650;
    letter-spacing: 0;
    margin: 16px 0 0;
  }
  .server code {
    background: var(--chip);
    padding: 0.1em 0.35em;
    border-radius: 6px;
  }
  .server .cmds :global(code) {
    background: none;
    padding: 12px 14px;
  }
  @media (max-width: 900px) {
    .cards {
      grid-template-columns: minmax(0, 1fr);
    }
  }
  @media (max-width: 600px) {
    .cards.two {
      grid-template-columns: minmax(0, 1fr);
    }
    .pairing {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
