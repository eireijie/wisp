{
  "name": "@wisp/desktop",
  "productName": "Wisp",
  "version": "0.0.2",
  "description": "Wisp for Mac, Windows and Linux: the workspace in its own window, a hub on this computer, and this computer as a device for agents.",
  "license": "Apache-2.0",
  "private": true,
  "main": "src/main.cjs",
  "scripts": {
    "start": "electron .",
    "bundle": "node scripts/bundle-wisp.mjs",
    "dist": "npm run bundle && electron-builder --dir",
    "dist:mac": "npm run bundle && electron-builder --mac",
    "dist:win": "npm run bundle && electron-builder --win",
    "dist:linux": "npm run bundle && electron-builder --linux"
  },
  "build": {
    "appId": "ai.wisp.desktop",
    "productName": "Wisp",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "build/icon.png",
      "build/trayTemplate*.png",
      "!**/node_modules/**"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "build/icon.png",
      "target": [
        "dmg",
        "zip"
      ],
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Wisp uses your microphone when you call an agent.",
        "NSAppleEventsUsageDescription": "Wisp uses this to let your agents work on this Mac's screen when you lend it to them.",
        "NSLocalNetworkUsageDescription": "Wisp finds and connects to Wisp on your other computers over your own network.",
        "NSBonjourServices": [
          "_wisp._tcp"
        ]
      },
      "artifactName": "Wisp-mac-${arch}.${ext}"
    },
    "win": {
      "icon": "build/icon.png",
      "target": [
        "nsis"
      ],
      "artifactName": "Wisp-win-${arch}.${ext}"
    },
    "linux": {
      "icon": "build/icon.png",
      "executableName": "wisp",
      "maintainer": "Wisp contributors <wisp@localhost>",
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Office",
      "artifactName": "Wisp-linux-${arch}.${ext}"
    },
    "afterPack": "scripts/after-pack.cjs",
    "afterSign": "scripts/after-sign.cjs",
    "publish": null,
    "protocols": [
      {
        "name": "Wisp pairing",
        "schemes": [
          "wisp",
          "warren"
        ]
      }
    ],
    "executableName": "wisp",
    "appImage": {
      "artifactName": "Wisp-linux-x86_64.${ext}"
    },
    "deb": {
      "artifactName": "Wisp-linux-amd64.${ext}"
    }
  },
  "devDependencies": {
    "electron": "44.7.2",
    "electron-builder": "^26.15.3"
  },
  "dependencies": {
    "bonjour-service": "^1.3.0"
  },
  "author": "Wisp contributors",
  "homepage": "https://github.com/eireijie/wisp"
}
